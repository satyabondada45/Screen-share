<?php
require_once __DIR__ . '/includes/db.php';
require_once __DIR__ . '/includes/auth.php';
require_once __DIR__ . '/includes/layout.php';

admin_require_auth();
$pdo = admin_db();
$table = admin_table_exists($pdo, 'plans') ? 'plans' : null;
$planColumns = $table ? admin_table_columns($pdo, $table) : [];

$rowHtml = '<tr><td colspan="6" class="empty-state">No plans found.</td></tr>';
if ($table) {
    try {
        $orderBy = in_array('created_at', $planColumns, true) ? ' ORDER BY `created_at` DESC' : (in_array('id', $planColumns, true) ? ' ORDER BY `id` DESC' : '');
        $stmt = $pdo->query('SELECT * FROM `plans`' . $orderBy);
        $rows = $stmt->fetchAll(PDO::FETCH_ASSOC);
        if ($rows) {
            $rowHtml = '';
            foreach ($rows as $row) {
                $status = strtoupper((string) ($row['status'] ?? 'Active'));
                $rowHtml .= '<tr><td>' . htmlspecialchars((string) ($row['name'] ?? 'Plan')) . '</td><td>' . htmlspecialchars((string) ($row['description'] ?? '')) . '</td><td>₹' . number_format((float) ($row['price'] ?? 0), 2) . '</td><td>' . (int) ($row['duration_days'] ?? 0) . ' days</td><td><span class="status-badge status-' . strtolower(str_replace(' ', '-', $status)) . '">' . htmlspecialchars($status) . '</span></td><td><div class="mini-actions"><a class="outline-button" href="' . htmlspecialchars(admin_url('plans.php', ['edit' => (string) ($row['id'] ?? '')]), ENT_QUOTES, 'UTF-8') . '">Edit</a></div></td></tr>';
            }
        }
    } catch (Throwable $e) {
        error_log('Plans page error: ' . $e->getMessage());
    }
}

if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['plan_submit'])) {
    if (!admin_verify_csrf_token($_POST['csrf_token'] ?? null)) {
        admin_set_flash('error', 'Invalid request token. Please refresh and try again.');
    } else {
        $name = trim((string) ($_POST['name'] ?? ''));
        $description = trim((string) ($_POST['description'] ?? ''));
        $priceInput = $_POST['price'] ?? null;
        $price = is_numeric($priceInput) ? (float) $priceInput : -1;
        $duration = filter_var($_POST['duration_days'] ?? null, FILTER_VALIDATE_INT);
        $status = (string) ($_POST['status'] ?? 'active');
        try {
            if ($table === null || !in_array('name', $planColumns, true)) {
                throw new RuntimeException('The existing plans table does not support plan creation.');
            }
            if ($name === '' || $price < 0 || $duration === false || $duration < 1 || !in_array($status, ['active', 'inactive'], true)) {
                throw new InvalidArgumentException('Enter a valid plan name, price, duration, and status.');
            }
            $values = ['name' => $name];
            foreach (['description' => $description, 'duration_days' => $duration, 'price' => $price, 'status' => $status] as $column => $value) {
                if (in_array($column, $planColumns, true)) {
                    $values[$column] = $value;
                }
            }
            $columns = array_keys($values);
            $quotedColumns = array_map(static fn($column) => '`' . $column . '`', $columns);
            $stmt = $pdo->prepare('INSERT INTO `plans` (' . implode(', ', $quotedColumns) . ') VALUES (' . implode(', ', array_fill(0, count($columns), '?')) . ')');
            $stmt->execute(array_values($values));
            admin_set_flash('success', 'Plan created successfully.');
        } catch (InvalidArgumentException $e) {
            admin_set_flash('error', $e->getMessage());
        } catch (Throwable $e) {
            error_log('Plan create error: ' . $e->getMessage());
            admin_set_flash('error', $e instanceof RuntimeException ? $e->getMessage() : 'Unable to save plan. Check the server error log.');
        }
    }
}

$csrfToken = htmlspecialchars(admin_csrf_token(), ENT_QUOTES, 'UTF-8');
$body = <<<HTML
<div class="section">
    <div class="section-header">
        <h3>Plans</h3>
        <div class="mini-actions"><button class="button" type="button" onclick="document.getElementById('plan-form').scrollIntoView({behavior:'smooth'});">Create plan</button></div>
    </div>
    <div style="overflow:auto;">
        <table>
            <thead>
                <tr>
                    <th>Plan Name</th>
                    <th>Description</th>
                    <th>Price</th>
                    <th>Duration</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {$rowHtml}
            </tbody>
        </table>
    </div>
</div>

<div class="section" id="plan-form">
    <div class="section-header"><h3>Create Plan</h3></div>
    <div class="detail-panels">
        <form method="POST" style="width:100%;">
            <input type="hidden" name="csrf_token" value="{$csrfToken}">
            <input type="hidden" name="plan_submit" value="1">
            <div class="grid-two">
                <div class="field"><label>Plan Name</label><input type="text" name="name" required></div>
                <div class="field"><label>Price</label><input type="number" step="0.01" min="0" name="price" required></div>
                <div class="field"><label>Duration in Days</label><input type="number" min="1" name="duration_days" value="30" required></div>
                <div class="field"><label>Status</label><select name="status"><option value="active">Active</option><option value="inactive">Inactive</option></select></div>
                <div class="field" style="grid-column:1 / -1;"><label>Description</label><textarea name="description" rows="4"></textarea></div>
            </div>
            <div class="mini-actions" style="padding-top:16px;"><button class="button" type="submit">Save plan</button></div>
        </form>
    </div>
</div>
HTML;

echo admin_render_page('Plans', 'plans', $body);
