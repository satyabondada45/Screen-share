<?php
require_once __DIR__ . '/includes/db.php';
require_once __DIR__ . '/includes/auth.php';
require_once __DIR__ . '/includes/layout.php';

admin_require_auth();
$pdo = admin_db();
$subscriptionTable = admin_table_exists($pdo, 'subscriptions') ? 'subscriptions' : null;
$planTable = admin_table_exists($pdo, 'plans') ? 'plans' : null;
$deviceTable = admin_table_exists($pdo, 'devices') ? 'devices' : null;

$search = trim((string) ($_GET['q'] ?? ''));
$status = (string) ($_GET['status'] ?? 'all');
$status = in_array($status, ['all', 'active', 'expired', 'cancelled', 'pending'], true) ? $status : 'all';

$where = [];
$params = [];
if ($search !== '') {
    $searchColumns = [];
    foreach (['device_id', 'device_uid', 'system_id', 'plan_name', 'email', 'status'] as $column) {
        if ($subscriptionTable && admin_column_exists($pdo, $subscriptionTable, $column)) {
            $searchColumns[] = '`' . $column . '` LIKE ?';
            $params[] = '%' . $search . '%';
        }
    }
    if ($searchColumns) {
        $where[] = '(' . implode(' OR ', $searchColumns) . ')';
    } else {
        $where[] = '1 = 0';
    }
}
if ($status !== 'all' && $subscriptionTable && admin_column_exists($pdo, $subscriptionTable, 'status')) {
    $where[] = 'status = ?';
    $params[] = $status;
}

$rowHtml = '<tr><td colspan="9" class="empty-state">No subscriptions found.</td></tr>';
if ($subscriptionTable) {
    try {
        $sql = 'SELECT * FROM `' . $subscriptionTable . '`';
        if ($where) { $sql .= ' WHERE ' . implode(' AND ', $where); }
        if (admin_column_exists($pdo, $subscriptionTable, 'created_at')) {
            $sql .= ' ORDER BY `created_at` DESC';
        } elseif (admin_column_exists($pdo, $subscriptionTable, 'id')) {
            $sql .= ' ORDER BY `id` DESC';
        }
        $stmt = $pdo->prepare($sql);
        $stmt->execute($params);
        $rows = $stmt->fetchAll(PDO::FETCH_ASSOC);
        if ($rows) {
            $rowHtml = '';
            foreach ($rows as $row) {
                $deviceRef = $row['device_id'] ?? 'Device';
                $planName = $row['plan_name'] ?? ($row['plan_id'] ?? 'N/A');
                $start = $row['start_date'] ?? 'N/A';
                $recharge = $row['recharge_date'] ?? 'N/A';
                $expiry = $row['expiry_date'] ?? 'N/A';
                $statusValue = strtoupper((string) ($row['status'] ?? 'Active'));
                $amount = $row['amount'] ?? 0;
                if ($planTable && isset($row['plan_id']) && admin_column_exists($pdo, $planTable, 'id') && admin_column_exists($pdo, $planTable, 'name')) {
                    $planStmt = $pdo->prepare('SELECT `name` FROM `plans` WHERE `id` = ? LIMIT 1');
                    $planStmt->execute([(int) $row['plan_id']]);
                    $planName = $planStmt->fetchColumn() ?: $planName;
                }
                $rowHtml .= '<tr><td>' . htmlspecialchars((string) $deviceRef, ENT_QUOTES, 'UTF-8') . '</td><td>' . htmlspecialchars((string) $planName, ENT_QUOTES, 'UTF-8') . '</td><td>' . htmlspecialchars((string) $start, ENT_QUOTES, 'UTF-8') . '</td><td>' . htmlspecialchars((string) $recharge, ENT_QUOTES, 'UTF-8') . '</td><td>' . htmlspecialchars((string) $expiry, ENT_QUOTES, 'UTF-8') . '</td><td><span class="status-badge status-' . strtolower(str_replace(' ', '-', $statusValue)) . '">' . htmlspecialchars($statusValue, ENT_QUOTES, 'UTF-8') . '</span></td><td>₹' . number_format((float) $amount, 2) . '</td><td><a class="outline-button" href="' . htmlspecialchars(admin_url('devices.php', ['subscription' => (string) $deviceRef]), ENT_QUOTES, 'UTF-8') . '">Manage</a></td></tr>';
            }
        }
    } catch (Throwable $e) {
        error_log('Subscriptions page error: ' . $e->getMessage());
    }
}

$subscriptionsUrl = htmlspecialchars(admin_url('subscriptions.php'), ENT_QUOTES, 'UTF-8');
$searchValue = htmlspecialchars($search, ENT_QUOTES, 'UTF-8');
$statusOptions = '';
foreach (['all' => 'All', 'active' => 'Active', 'expired' => 'Expired', 'pending' => 'Pending', 'cancelled' => 'Cancelled'] as $value => $label) {
    $statusOptions .= '<option value="' . $value . '"' . ($status === $value ? ' selected' : '') . '>' . $label . '</option>';
}
$body = <<<HTML
<div class="section">
    <div class="section-header">
        <h3>Subscriptions</h3>
        <div class="filters">
            <form method="GET" action="{$subscriptionsUrl}" style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
                <input type="text" name="q" value="{$searchValue}" placeholder="Search device, plan" style="border:1px solid var(--border); border-radius:10px; padding:10px 12px; min-width:220px;">
                <select name="status" style="border:1px solid var(--border); border-radius:10px; padding:10px 12px;">{$statusOptions}</select>
                <button class="button" type="submit">Filter</button>
            </form>
        </div>
    </div>
    <div style="overflow:auto;">
        <table>
            <thead>
                <tr>
                    <th>Device ID</th>
                    <th>Plan</th>
                    <th>Start</th>
                    <th>Recharge</th>
                    <th>Expiry</th>
                    <th>Status</th>
                    <th>Amount</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {$rowHtml}
            </tbody>
        </table>
    </div>
</div>
HTML;

echo admin_render_page('Subscriptions', 'subscriptions', $body);
